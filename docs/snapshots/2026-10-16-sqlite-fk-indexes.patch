+var foreignKeyChildIndexDDL = []string{
+	analysisStepsNodeForeignKeyIndexDDL,
+	refViewBuildsForeignKeyIndexDDL,
+	dedicatedGraphsFamilyForeignKeyIndexDDL,
+}
