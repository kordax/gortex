+// createForeignKeyChildIndexes upgrades existing stores without rebuilding any
+// data. The names deliberately match the indexes used to repair affected stores
+// manually, so an upgrade does not create duplicate copies of those indexes.
+func createForeignKeyChildIndexes(tx *sql.Tx) error {
+	for _, ddl := range foreignKeyChildIndexDDL {
+		if _, err := tx.Exec(ddl); err != nil {
+			return err
+		}
+	}
+	return nil
