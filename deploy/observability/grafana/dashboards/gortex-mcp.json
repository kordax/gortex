{
  "uid": "gortex-mcp",
  "title": "Gortex / MCP requests",
  "tags": ["gortex", "mcp"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [{"name": "instance", "label": "Daemon", "type": "query", "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "query": "label_values(up{job=\"gortex\"}, instance)", "refresh": 1}, {"name": "operation", "label": "Operation", "type": "query", "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "query": "label_values(gortex_mcp_requests_total{job=\"gortex\",instance=\"$instance\"}, operation)", "includeAll": true, "allValue": ".*", "multi": true, "refresh": 2}]},
  "panels": [
    {"id": 1, "title": "How to interpret latency", "type": "text", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 3}, "options": {"mode": "markdown", "content": "Histogram quantiles need completed calls and several scrapes. A missing series is unavailable, not zero latency or zero failures. In-flight and abandoned-handler counts help separate slow live work from completed requests. Request labels contain bounded tool/operation identities, not repository paths or request IDs. Use the optional Tempo datasource in Explore for sampled traces; tracing must be enabled separately."}},
    {"id": 2, "title": "Completed requests / second", "type": "timeseries", "gridPos": {"x": 0, "y": 3, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "sum by (kind, operation) (rate(gortex_mcp_requests_total{job=\"gortex\",instance=\"$instance\",operation=~\"$operation\"}[$__rate_interval]))", "legendFormat": "{{kind}} / {{operation}}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "unit": "reqps"}}},
    {"id": 3, "title": "Completed outcomes / second", "type": "timeseries", "gridPos": {"x": 12, "y": 3, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "sum by (outcome) (rate(gortex_mcp_requests_total{job=\"gortex\",instance=\"$instance\",operation=~\"$operation\"}[$__rate_interval]))", "legendFormat": "{{outcome}}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "unit": "reqps"}}},
    {"id": 4, "title": "Latency p50 / p95 / p99", "type": "timeseries", "gridPos": {"x": 0, "y": 11, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate(gortex_mcp_request_duration_seconds_bucket{job=\"gortex\",instance=\"$instance\",operation=~\"$operation\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "A"}, {"expr": "histogram_quantile(0.95, sum by (le) (rate(gortex_mcp_request_duration_seconds_bucket{job=\"gortex\",instance=\"$instance\",operation=~\"$operation\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "B"}, {"expr": "histogram_quantile(0.99, sum by (le) (rate(gortex_mcp_request_duration_seconds_bucket{job=\"gortex\",instance=\"$instance\",operation=~\"$operation\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "C"}], "fieldConfig": {"defaults": {"min": 0, "unit": "s"}}},
    {"id": 5, "title": "p95 latency by tool and operation", "type": "timeseries", "gridPos": {"x": 12, "y": 11, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, kind, operation) (rate(gortex_mcp_request_duration_seconds_bucket{job=\"gortex\",instance=\"$instance\",operation=~\"$operation\"}[$__rate_interval])))", "legendFormat": "{{kind}} / {{operation}}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "unit": "s"}}},
    {"id": 6, "title": "In-flight requests", "type": "timeseries", "gridPos": {"x": 0, "y": 19, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "gortex_mcp_requests_in_flight{job=\"gortex\",instance=\"$instance\",operation=~\"$operation\"}", "legendFormat": "{{kind}} / {{operation}}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "unit": "short"}}},
    {"id": 7, "title": "Abandoned handlers still running", "type": "timeseries", "gridPos": {"x": 12, "y": 19, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "gortex_mcp_abandoned_handlers{job=\"gortex\",instance=\"$instance\"}", "legendFormat": "handlers", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "unit": "short"}}}
  ]
}
