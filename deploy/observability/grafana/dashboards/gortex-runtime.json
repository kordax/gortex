{
  "uid": "gortex-runtime",
  "title": "Gortex / Runtime and readiness",
  "tags": ["gortex", "daemon"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [{"name": "instance", "label": "Daemon", "type": "query", "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "query": "label_values(up{job=\"gortex\"}, instance)", "refresh": 1}]},
  "panels": [
    {"id": 1, "title": "Reading these metrics", "type": "text", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 3}, "options": {"mode": "markdown", "content": "Scrape health is separate from graph readiness and enrichment. **No data means unavailable**, never zero. CPU is cores (1.0 = one core). Go Sys is runtime-managed address space, not RSS. Child RSS can count shared pages more than once; do not add it to PSS as a memory total. Trigram cache limits are budgets, not allocated memory. Metrics cover the daemon and its children; independent MCP client processes and this monitoring stack are outside that process family."}},
    {"id": 2, "title": "Scrape healthy", "type": "stat", "gridPos": {"x": 0, "y": 3, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "up{job=\"gortex\",instance=\"$instance\"}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}}},
    {"id": 3, "title": "Graph ready", "type": "stat", "gridPos": {"x": 6, "y": 3, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "gortex_daemon_ready{job=\"gortex\",instance=\"$instance\"}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "max": 1}}},
    {"id": 4, "title": "Enrichment complete", "type": "stat", "gridPos": {"x": 12, "y": 3, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "gortex_daemon_enrichment_complete{job=\"gortex\",instance=\"$instance\"}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "max": 1}}},
    {"id": 5, "title": "Warmup duration", "type": "stat", "gridPos": {"x": 18, "y": 3, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "gortex_daemon_warmup_duration_seconds{job=\"gortex\",instance=\"$instance\"}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 6, "title": "CPU cores", "type": "timeseries", "gridPos": {"x": 0, "y": 7, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "rate(gortex_process_cpu_seconds_total{job=\"gortex\",instance=\"$instance\"}[$__rate_interval])", "legendFormat": "daemon", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "unit": "short"}}},
    {"id": 7, "title": "Process memory", "type": "timeseries", "gridPos": {"x": 12, "y": 7, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "gortex_process_resident_memory_bytes{job=\"gortex\",instance=\"$instance\"}", "legendFormat": "daemon RSS", "refId": "A"}, {"expr": "gortex_process_pss_memory_bytes{job=\"gortex\",instance=\"$instance\"}", "legendFormat": "daemon PSS", "refId": "B"}, {"expr": "gortex_children_resident_memory_bytes{job=\"gortex\",instance=\"$instance\"}", "legendFormat": "children summed RSS", "refId": "C"}], "fieldConfig": {"defaults": {"min": 0, "unit": "bytes"}}},
    {"id": 8, "title": "Go memory", "type": "timeseries", "gridPos": {"x": 0, "y": 14, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "gortex_runtime_heap_alloc_bytes{job=\"gortex\",instance=\"$instance\"}", "legendFormat": "heap allocated", "refId": "A"}, {"expr": "gortex_runtime_heap_inuse_bytes{job=\"gortex\",instance=\"$instance\"}", "legendFormat": "heap in use", "refId": "B"}, {"expr": "gortex_runtime_heap_idle_bytes{job=\"gortex\",instance=\"$instance\"}", "legendFormat": "heap idle", "refId": "C"}, {"expr": "gortex_runtime_heap_released_bytes{job=\"gortex\",instance=\"$instance\"}", "legendFormat": "heap released", "refId": "D"}, {"expr": "gortex_runtime_sys_bytes{job=\"gortex\",instance=\"$instance\"}", "legendFormat": "Go Sys (not RSS)", "refId": "E"}, {"expr": "gortex_runtime_stack_inuse_bytes{job=\"gortex\",instance=\"$instance\"}", "legendFormat": "stacks", "refId": "F"}], "fieldConfig": {"defaults": {"min": 0, "unit": "bytes"}}},
    {"id": 9, "title": "Runtime activity", "type": "timeseries", "gridPos": {"x": 12, "y": 14, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "gortex_runtime_goroutines{job=\"gortex\",instance=\"$instance\"}", "legendFormat": "goroutines", "refId": "A"}, {"expr": "gortex_child_processes{job=\"gortex\",instance=\"$instance\"}", "legendFormat": "child processes", "refId": "B"}], "fieldConfig": {"defaults": {"min": 0, "unit": "short"}}},
    {"id": 10, "title": "Sessions by state", "type": "timeseries", "gridPos": {"x": 0, "y": 21, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "gortex_daemon_sessions{job=\"gortex\",instance=\"$instance\"}", "legendFormat": "{{state}}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "unit": "short"}}},
    {"id": 11, "title": "Repositories by state", "type": "timeseries", "gridPos": {"x": 12, "y": 21, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "gortex_daemon_repos{job=\"gortex\",instance=\"$instance\"}", "legendFormat": "{{state}}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "unit": "short"}}},
    {"id": 12, "title": "Trigram cache memory and budget", "type": "timeseries", "gridPos": {"x": 0, "y": 28, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "gortex_cache_bytes{job=\"gortex\",instance=\"$instance\",cache=\"trigram\"}", "legendFormat": "live bytes", "refId": "A"}, {"expr": "gortex_cache_limit_bytes{job=\"gortex\",instance=\"$instance\",cache=\"trigram\"}", "legendFormat": "limit", "refId": "B"}], "fieldConfig": {"defaults": {"min": 0, "unit": "bytes"}}},
    {"id": 13, "title": "Trigram cache entries", "type": "timeseries", "gridPos": {"x": 12, "y": 28, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "gortex_cache_entries{job=\"gortex\",instance=\"$instance\",cache=\"trigram\"}", "legendFormat": "entries", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "unit": "short"}}},
    {"id": 14, "title": "Disk I/O", "type": "timeseries", "gridPos": {"x": 0, "y": 35, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "rate(gortex_process_io_bytes_total{job=\"gortex\",instance=\"$instance\"}[$__rate_interval])", "legendFormat": "{{direction}}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "unit": "Bps"}}},
    {"id": 15, "title": "GC cycles / second", "type": "timeseries", "gridPos": {"x": 12, "y": 35, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "rate(gortex_runtime_gc_cycles_total{job=\"gortex\",instance=\"$instance\"}[$__rate_interval])", "legendFormat": "GC cycles/s", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "unit": "ops"}}},
    {"id": 16, "title": "Daemon phase history", "type": "state-timeline", "gridPos": {"x": 0, "y": 42, "w": 24, "h": 7}, "datasource": {"type": "prometheus", "uid": "gortex-prometheus"}, "targets": [{"expr": "gortex_daemon_phase{job=\"gortex\",instance=\"$instance\"}", "legendFormat": "{{phase}}", "refId": "A"}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"1": {"text": "active"}}}]}}, "options": {"mergeValues": true, "showValue": "never", "rowHeight": 0.8}}
  ]
}
